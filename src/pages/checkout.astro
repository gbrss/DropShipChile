---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Checkout — DropShip Chile">
  <Header />
  <main class="max-w-2xl mx-auto px-4 sm:px-6 py-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Finalizar compra</h1>
    <div id="checkout-empty" class="hidden text-center py-12">
      <p class="text-gray-500 mb-4">No hay productos en el carrito</p>
      <a href="/" class="btn-primary">Volver a la tienda</a>
    </div>
    <div id="checkout-form" class="hidden space-y-6">
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h2 class="font-semibold text-gray-900 mb-4">Resumen del pedido</h2>
        <div id="order-summary" class="space-y-2 text-sm"></div>
        <div class="border-t border-gray-100 mt-4 pt-4 flex justify-between">
          <span class="font-semibold">Total</span>
          <span id="order-total" class="text-xl font-bold text-brand-700">$0</span>
        </div>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h2 class="font-semibold text-gray-900 mb-4">Datos de envío</h2>
        <form id="pay-form" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Nombre completo</label>
            <input type="text" name="name" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none" placeholder="Juan Pérez" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input type="email" name="email" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none" placeholder="juan@email.com" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Teléfono</label>
            <input type="tel" name="phone" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none" placeholder="+56 9 1234 5678" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Dirección</label>
            <input type="text" name="address" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none" placeholder="Av. Providencia 1234, Santiago" />
          </div>
          <div class="bg-brand-50 border border-brand-100 rounded-lg p-4 text-sm text-brand-800">
            <strong>🔒 Pago con WebPay</strong><br/>
            Serás redirigido a Transbank para pagar con débito o crédito de forma segura.
            <br/><span class="text-xs text-brand-600 mt-1 block">Modo integración (sandbox) — usa tarjeta de prueba: 4051885600446623</span>
          </div>
          <button type="submit" id="pay-btn" class="btn-primary w-full text-lg py-3">
            Pagar con WebPay
          </button>
          <p id="pay-error" class="text-red-600 text-sm hidden"></p>
        </form>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
<script>
  function formatCLP(n: number) {
    return new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', minimumFractionDigits: 0 }).format(n);
  }
  const cart = JSON.parse(localStorage.getItem('cart') || '[]');
  const empty = document.getElementById('checkout-empty')!;
  const form = document.getElementById('checkout-form')!;
  if (cart.length === 0) {
    empty.classList.remove('hidden');
  } else {
    form.classList.remove('hidden');
    let total = 0;
    document.getElementById('order-summary')!.innerHTML = cart.map((i: any) => {
      total += i.price * i.qty;
      return `<div class="flex justify-between"><span>${i.name} × ${i.qty}</span><span>${formatCLP(i.price * i.qty)}</span></div>`;
    }).join('');
    document.getElementById('order-total')!.textContent = formatCLP(total);

    document.getElementById('pay-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('pay-btn') as HTMLButtonElement;
      const errEl = document.getElementById('pay-error')!;
      btn.disabled = true;
      btn.textContent = 'Procesando...';
      errEl.classList.add('hidden');
      try {
        const fd = new FormData(e.target as HTMLFormElement);
        const res = await fetch('/api/webpay/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            amount: total,
            buyOrder: 'DS' + Date.now(),
            sessionId: 'sess-' + Date.now(),
            customer: {
              name: fd.get('name'),
              email: fd.get('email'),
              phone: fd.get('phone'),
              address: fd.get('address'),
            },
            items: cart,
          }),
        });
        const data = await res.json();
        if (!res.ok || data.error) throw new Error(data.error || 'Error al crear transacción');
        // Redirect to WebPay
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = data.url;
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'token_ws';
        input.value = data.token;
        form.appendChild(input);
        document.body.appendChild(form);
        form.submit();
      } catch (err: any) {
        errEl.textContent = err.message || 'Error de conexión';
        errEl.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Pagar con WebPay';
      }
    });
  }
</script>
